.env
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDEs and editors
.vscode/
.idea/

# OS files
.DS_Store

# dotenv and secrets
.env
.env.*
secrets.json

# Data files (runtime persistence should not be committed)
/data/
data/

# Misc
*.log
*.sqlite

# Ignore Python bytecode and caches
*.pyc